FORMSYNC_DATA_DIR=./data
# Optional Supabase Auth and coach collaboration (apply supabase/migrations first):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Optional Web Push reminders (generate with: npx web-push generate-vapid-keys):
# FORMSYNC_VAPID_PUBLIC_KEY=
# FORMSYNC_VAPID_PRIVATE_KEY=
# FORMSYNC_VAPID_SUBJECT=mailto:admin@example.com
# Optional Stripe subscriptions and invoices:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FORMSYNC_STRIPE_PRICE_PRO=
# FORMSYNC_STRIPE_PRICE_TEAM=
# Optional support operations and error alerts:
# FORMSYNC_ADMIN_TOKEN=
# FORMSYNC_ALERT_WEBHOOK=https://example.invalid/your-secure-webhook
# FORMSYNC_HEALTH_TOKEN=
# Optional automated health check target for npm run ops:check:
# FORMSYNC_HEALTH_URL=https://your-app.example.com/api/health
# Optional S3-compatible object storage:
# FORMSYNC_S3_BUCKET=formsync-videos
# FORMSYNC_S3_REGION=auto
# FORMSYNC_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# FORMSYNC_S3_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FORMSYNC_BACKUP_DIR=./backups
# Optional trusted executable overrides:
# FORMSYNC_FFMPEG_PATH=C:/tools/ffmpeg.exe
# FORMSYNC_FFPROBE_PATH=C:/tools/ffprobe.exe